{
  "multipart": [
    {
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/top"
      }
    },
    {
      "when": {
        "connected_down": "false"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/down_closed"
      }
    },
    {
      "when": {
        "connected_down": "true"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/down_open"
      }
    },
    {
      "when": {
        "connected_north": "false"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/north_closed"
      }
    },
    {
      "when": {
        "connected_north": "true"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/north_open"
      }
    },
    {
      "when": {
        "connected_south": "false"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/south_closed"
      }
    },
    {
      "when": {
        "connected_south": "true"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/south_open"
      }
    },
    {
      "when": {
        "connected_east": "false"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/east_closed"
      }
    },
    {
      "when": {
        "connected_east": "true"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/east_open"
      }
    },
    {
      "when": {
        "connected_west": "false"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/west_closed"
      }
    },
    {
      "when": {
        "connected_west": "true"
      },
      "apply": {
        "model": "buildcraftfactory:block/flood_gate/west_open"
      }
    }
  ]
}
